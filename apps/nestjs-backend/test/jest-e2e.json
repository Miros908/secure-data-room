{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "maxWorkers": 1,
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "globalSetup": "<rootDir>/global-setup.cjs",
  "testTimeout": 20000,
  "testRegex": ".e2e-spec.ts$",
  "testPathIgnorePatterns": ["/node_modules/"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
