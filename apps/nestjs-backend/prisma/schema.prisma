generator client {
  provider        = "prisma-client"
  output          = "../src/database/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OauthProvider {
  GOOGLE
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AccessRole {
  VIEWER
  EDITOR
}

enum ActivityEventType {
  FILE_VIEWED
  FILE_DOWNLOADED
  LINK_OPENED
  ACCESS_GRANTED
  ACCESS_REVOKED
  FILE_DELETED
  FOLDER_DELETED
}

model users {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.VarChar(320)
  password_hash     String?    @db.VarChar(255)
  name              String     @db.VarChar(120)
  email_verified_at DateTime?  @db.Timestamptz
  status            UserStatus @default(ACTIVE)
  created_at        DateTime   @default(now()) @db.Timestamptz
  updated_at        DateTime   @updatedAt @db.Timestamptz

  oauth_accounts oauth_accounts[]
  auth_sessions  auth_sessions[]
  auth_tokens    auth_tokens[]

  owned_data_rooms       data_rooms[]
  uploaded_files         files[]
  uploaded_file_versions file_versions[]

  received_access_grants access_grants[] @relation("AccessRecipient")
  created_access_grants  access_grants[] @relation("AccessGrantedBy")

  created_access_invitations access_invitations[]
  created_public_share_links public_share_links[]
  activity_events            activity_events[]
}

model oauth_accounts {
  id                  String        @id @default(uuid()) @db.Uuid
  user_id             String        @db.Uuid
  provider            OauthProvider
  provider_account_id String        @db.VarChar(255)
  created_at          DateTime      @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@unique([user_id, provider])
  @@index([user_id])
}

model auth_sessions {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique @db.VarChar(64)
  expires_at         DateTime  @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz
  last_used_at       DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@index([user_id, revoked_at])
}

model auth_tokens {
  id         String        @id @default(uuid()) @db.Uuid
  user_id    String        @db.Uuid
  type       AuthTokenType
  token_hash String        @unique @db.VarChar(64)
  expires_at DateTime      @db.Timestamptz
  used_at    DateTime?     @db.Timestamptz
  created_at DateTime      @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type])
}

model data_rooms {
  id         String   @id @default(uuid()) @db.Uuid
  owner_id   String   @db.Uuid
  name       String   @db.VarChar(120)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  owner users @relation(fields: [owner_id], references: [id])

  folders            folders[]
  files              files[]
  access_grants      access_grants[]
  access_invitations access_invitations[]
  public_share_links public_share_links[]
  activity_events    activity_events[]

  @@unique([owner_id])
}

model folders {
  id           String   @id @default(uuid()) @db.Uuid
  data_room_id String   @db.Uuid
  parent_id    String?  @db.Uuid
  name         String   @db.VarChar(255)
  path         String   @db.VarChar(2048)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  data_room data_rooms @relation(fields: [data_room_id], references: [id], onDelete: Cascade)

  parent   folders?  @relation("FolderTree", fields: [parent_id, data_room_id], references: [id, data_room_id], onDelete: Cascade)
  children folders[] @relation("FolderTree")

  files              files[]
  access_grants      access_grants[]
  access_invitations access_invitations[]
  public_share_links public_share_links[]

  @@unique([id, data_room_id], map: "folders_id_data_room_key")
  @@unique([data_room_id, name], map: "folders_root_name_key", where: raw("parent_id IS NULL"))
  @@unique([parent_id, name], map: "folders_parent_name_key", where: raw("parent_id IS NOT NULL"))
  @@index([data_room_id, parent_id, name, id])
  @@index([data_room_id, path])
}

model files {
  id                 String   @id @default(uuid()) @db.Uuid
  data_room_id       String   @db.Uuid
  folder_id          String?  @db.Uuid
  uploaded_by_id     String   @db.Uuid
  name               String   @db.VarChar(255)
  mime_type          String   @db.VarChar(127)
  size_bytes         BigInt
  current_version_id String?  @unique @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz
  updated_at         DateTime @updatedAt @db.Timestamptz

  data_room       data_rooms      @relation(fields: [data_room_id], references: [id], onDelete: Cascade)
  folder          folders?        @relation(fields: [folder_id, data_room_id], references: [id, data_room_id], onDelete: Cascade)
  uploaded_by     users           @relation(fields: [uploaded_by_id], references: [id])
  current_version file_versions?  @relation("FileCurrentVersion", fields: [current_version_id], references: [id], onDelete: Restrict)
  versions        file_versions[] @relation("FileVersions")

  access_grants      access_grants[]
  access_invitations access_invitations[]
  public_share_links public_share_links[]

  @@unique([id, data_room_id], map: "files_id_data_room_key")
  @@unique([data_room_id, name], map: "files_root_name_key", where: raw("folder_id IS NULL"))
  @@unique([folder_id, name], map: "files_folder_name_key", where: raw("folder_id IS NOT NULL"))
  @@index([data_room_id, folder_id, name, id])
  @@index([uploaded_by_id])
}

model file_versions {
  id             String   @id @default(uuid()) @db.Uuid
  file_id        String   @db.Uuid
  version_number Int
  storage_key    String   @unique @db.VarChar(512)
  mime_type      String   @db.VarChar(127)
  size_bytes     BigInt
  uploaded_by_id String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz

  file        files @relation("FileVersions", fields: [file_id], references: [id], onDelete: Cascade)
  current_for files? @relation("FileCurrentVersion")
  uploaded_by users @relation(fields: [uploaded_by_id], references: [id])

  @@unique([file_id, version_number], map: "file_versions_file_number_key")
  @@unique([id, file_id], map: "file_versions_id_file_id_key")
  @@index([file_id, created_at])
  @@index([uploaded_by_id])
}

model access_grants {
  id            String     @id @default(uuid()) @db.Uuid
  user_id       String     @db.Uuid
  granted_by_id String     @db.Uuid
  data_room_id  String     @db.Uuid
  folder_id     String?    @db.Uuid
  file_id       String?    @db.Uuid
  role          AccessRole @default(VIEWER)
  expires_at    DateTime?  @db.Timestamptz
  revoked_at    DateTime?  @db.Timestamptz
  created_at    DateTime   @default(now()) @db.Timestamptz
  updated_at    DateTime   @updatedAt @db.Timestamptz

  user       users      @relation("AccessRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  granted_by users      @relation("AccessGrantedBy", fields: [granted_by_id], references: [id])
  data_room  data_rooms @relation(fields: [data_room_id], references: [id], onDelete: Cascade)
  folder     folders?   @relation(fields: [folder_id, data_room_id], references: [id, data_room_id], onDelete: Cascade)
  file       files?     @relation(fields: [file_id, data_room_id], references: [id, data_room_id], onDelete: Cascade)

  @@unique([user_id, data_room_id], map: "access_grants_user_room_active_key", where: raw("folder_id IS NULL AND file_id IS NULL AND revoked_at IS NULL"))
  @@unique([user_id, folder_id], map: "access_grants_user_folder_active_key", where: raw("folder_id IS NOT NULL AND file_id IS NULL AND revoked_at IS NULL"))
  @@unique([user_id, file_id], map: "access_grants_user_file_active_key", where: raw("file_id IS NOT NULL AND folder_id IS NULL AND revoked_at IS NULL"))
  @@index([user_id, data_room_id, revoked_at])
  @@index([user_id, folder_id, revoked_at])
  @@index([user_id, file_id, revoked_at])
  @@index([granted_by_id])
}

model access_invitations {
  id            String     @id @default(uuid()) @db.Uuid
  granted_by_id String     @db.Uuid
  email         String     @db.VarChar(320)
  token_hash    String     @unique @db.VarChar(64)
  data_room_id  String     @db.Uuid
  folder_id     String?    @db.Uuid
  file_id       String?    @db.Uuid
  role          AccessRole @default(VIEWER)
  expires_at    DateTime   @db.Timestamptz
  access_expires_at DateTime? @db.Timestamptz
  accepted_at   DateTime?  @db.Timestamptz
  revoked_at    DateTime?  @db.Timestamptz
  created_at    DateTime   @default(now()) @db.Timestamptz
  updated_at    DateTime   @updatedAt @db.Timestamptz

  granted_by users      @relation(fields: [granted_by_id], references: [id])
  data_room  data_rooms @relation(fields: [data_room_id], references: [id], onDelete: Cascade)
  folder     folders?   @relation(fields: [folder_id, data_room_id], references: [id, data_room_id], onDelete: Cascade)
  file       files?     @relation(fields: [file_id, data_room_id], references: [id, data_room_id], onDelete: Cascade)

  @@unique([email, data_room_id], map: "access_invitations_email_room_pending_key", where: raw("folder_id IS NULL AND file_id IS NULL AND accepted_at IS NULL AND revoked_at IS NULL"))
  @@unique([email, folder_id], map: "access_invitations_email_folder_pending_key", where: raw("folder_id IS NOT NULL AND file_id IS NULL AND accepted_at IS NULL AND revoked_at IS NULL"))
  @@unique([email, file_id], map: "access_invitations_email_file_pending_key", where: raw("file_id IS NOT NULL AND folder_id IS NULL AND accepted_at IS NULL AND revoked_at IS NULL"))
  @@index([email])
  @@index([data_room_id])
  @@index([granted_by_id])
}

model public_share_links {
  id            String    @id @default(uuid()) @db.Uuid
  created_by_id String    @db.Uuid
  data_room_id  String    @db.Uuid
  folder_id     String?   @db.Uuid
  file_id       String?   @db.Uuid
  token_hash    String    @unique @db.VarChar(64)
  expires_at    DateTime? @db.Timestamptz
  revoked_at    DateTime? @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz

  created_by users      @relation(fields: [created_by_id], references: [id])
  data_room  data_rooms @relation(fields: [data_room_id], references: [id], onDelete: Cascade)
  folder     folders?   @relation(fields: [folder_id, data_room_id], references: [id, data_room_id], onDelete: Cascade)
  file       files?     @relation(fields: [file_id, data_room_id], references: [id, data_room_id], onDelete: Cascade)
  activity_events activity_events[]

  @@unique([data_room_id], map: "public_share_room_active_key", where: raw("folder_id IS NULL AND file_id IS NULL AND revoked_at IS NULL"))
  @@unique([folder_id], map: "public_share_folder_active_key", where: raw("folder_id IS NOT NULL AND file_id IS NULL AND revoked_at IS NULL"))
  @@unique([file_id], map: "public_share_file_active_key", where: raw("file_id IS NOT NULL AND folder_id IS NULL AND revoked_at IS NULL"))
  @@index([data_room_id, revoked_at])
  @@index([folder_id, revoked_at])
  @@index([file_id, revoked_at])
  @@index([created_by_id])
}

model activity_events {
  id                   String            @id @default(uuid()) @db.Uuid
  data_room_id         String            @db.Uuid
  type                 ActivityEventType
  actor_user_id        String?           @db.Uuid
  public_share_link_id String?           @db.Uuid
  file_id              String?           @db.Uuid
  folder_id            String?           @db.Uuid
  resource_name        String?           @db.VarChar(255)
  request_id           String            @db.VarChar(64)
  metadata             Json?
  created_at           DateTime          @default(now()) @db.Timestamptz

  data_room         data_rooms          @relation(fields: [data_room_id], references: [id], onDelete: Restrict)
  actor             users?              @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)
  public_share_link public_share_links? @relation(fields: [public_share_link_id], references: [id], onDelete: SetNull)

  @@index([data_room_id, created_at, id])
  @@index([data_room_id, actor_user_id, created_at])
  @@index([data_room_id, public_share_link_id, created_at])
  @@index([data_room_id, file_id, type])
  @@index([data_room_id, type, created_at])
}
