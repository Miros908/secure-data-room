DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_data_room?schema=public"
PORT=4000
NODE_ENV=development

# Фронт на другом origin (Vercel). Локально можно не задавать — отражаем Origin.
# Несколько URL через запятую, без хвостового слэша.
# CORS_ORIGIN=https://deal-box.vercel.app

# Хранилище файлов. local — папка на диске, нужна чтобы проект поднимался
# без доступа к R2; r2 — Cloudflare R2 через S3-совместимый API.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# Cloudflare R2. Бакет должен быть закрытым: публичный домен и r2.dev к нему
# не подключаются, файлы отдаются только по подписанным ссылкам.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=secure-data-room

# Префикс ключей, чтобы объекты разработки и продакшена не смешивались
# в одном бакете. К ключу его приклеивает модуль files, не хранилище.
STORAGE_KEY_PREFIX=dev

# Базовый URL бекенда — из него локальный драйвер собирает ссылку
# на GET /storage/objects. Для STORAGE_DRIVER=r2 не используется.
STORAGE_PUBLIC_BASE_URL=http://localhost:4000

# Секрет HMAC для локальных ссылок. В development есть значение по умолчанию;
# в production при STORAGE_DRIVER=local обязателен.
STORAGE_LOCAL_SIGNING_SECRET=
