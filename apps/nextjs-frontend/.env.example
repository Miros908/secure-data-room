# Базовый URL NestJS-бекенда. Префикс NEXT_PUBLIC_ обязателен:
# переменная читается в браузере axios-клиентом.
# Локально: http://localhost:4000
# Прод на Vercel: /backend — same-origin прокси (см. API_PROXY_ORIGIN),
# иначе Safari/телефон выкидывает third-party cookie с Render.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Прямой URL API для загрузки PDF (лимит тела на Vercel ~4.5 МБ).
# Локально можно не задавать — совпадает с NEXT_PUBLIC_API_URL.
# Прод: https://your-api.onrender.com — без хвостового слэша.
# NEXT_PUBLIC_UPLOAD_API_URL=https://your-api.onrender.com

# Куда Next.js проксирует /backend/* (только сервер, без NEXT_PUBLIC_).
# Прод на Vercel: https://your-api.onrender.com
# API_PROXY_ORIGIN=https://your-api.onrender.com

# Public site origin for Open Graph absolute URLs. No trailing slash.
# Locally: http://localhost:3000
# Prod: https://deal-box.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
